Stopwatch {   
    background: $surface;
    height: 7;
    margin: 1;
    min-width: 70;
    padding: 1;
}

TimeDisplay {   
    text-align: center;
    color: $foreground-muted;
    height: 3;
}

VerticalGroup {
    width: 1fr;
    min-width: 20;
}

Button {
    width: 16;
}

Static {
    width: 100%;
    text-align: center;
    color: $foreground-muted;
    height: 1;
}

#start {
    dock: left;
}

#stop {
    dock: left;
    display: none;
}

#reset {
    dock: right;
}